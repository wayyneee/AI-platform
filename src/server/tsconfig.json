{
  // 後端的型別檢查設定（只檢查，不產生檔案）；src/shared/ 也一起檢查，確保後端能用。
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    // 後端直接用 Node 內建的 TypeScript 執行：import 寫 .ts 副檔名，不用 enum、namespace 這類需要轉譯的寫法
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["**/*", "../shared/**/*"]
}
